{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "types": [
      "vite/client",
      "vite-plugin-pwa/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@fley27/shared/*": ["node_modules/@fley27/shared/src/*", "node_modules/@fley27/shared/*"]
    }
  },
  "include": [
    "src",
    "node_modules/@fley27/shared/src",
    "node_modules/@fley27/shared-types/src/index.ts",
    "node_modules/@fley27/catalog-core/src/index.ts"
  ]
}
